<!DOCTYPE html>
<html>

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>

/* =====================================================
   MATERIAL SYMBOLS
   ===================================================== */

@font-face {
    font-family: 'Material Symbols Rounded';
    font-style: normal;
    font-weight: 500;
    src: url(file:///android_asset/gicons.woff2) format('woff2');
}

.material-symbols-rounded {
    font-family: 'Material Symbols Rounded';
    font-weight: normal;
    font-style: normal;
    font-size: 24px;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    display: inline-block;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    -webkit-font-feature-settings: 'liga';
    -webkit-font-smoothing: antialiased;
}


/* =====================================================
   BASE
   ===================================================== */

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    background: transparent !important;
}

body {
    padding: 12px;
    font-family: Arial, sans-serif;
}


/* =====================================================
   HOME
   ===================================================== */

.home-section {
    width: 100%;
}

.section-title {
    font-size: 18px;
    font-weight: 700;
    margin: 4px 3px 12px;

    color: #202124;
}


/* =====================================================
   GRID
   ===================================================== */

.button-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}


/* =====================================================
   CARDS
   ===================================================== */

.home-button {
    position: relative;

    min-height: 105px;

    border-radius: 20px;

    background: #ffffff;

    border: 1px solid #edf0f4;

    padding: 16px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    cursor: pointer;
    overflow: hidden;

    box-shadow:
        0 3px 12px rgba(40, 50, 70, 0.06);

    transition:
        transform 0.15s ease,
        box-shadow 0.15s ease;
}

.home-button:active {
    transform: scale(0.97);

    box-shadow:
        0 2px 7px rgba(40, 50, 70, 0.05);
}


/* =====================================================
   ICON BOX
   ===================================================== */

.icon-box {
    width: 42px;
    height: 42px;

    border-radius: 14px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #eef3ff;
    color: #4263eb;
}

.icon-box .material-symbols-rounded {
    font-size: 24px;
}


/* =====================================================
   TEXT
   ===================================================== */

.button-name {
    font-size: 15px;
    font-weight: 700;

    margin-top: 12px;

    color: #252a34;
}

.button-subtitle {
    font-size: 11px;

    margin-top: 4px;

    color: #858b98;

    font-weight: 500;
}


/* =====================================================
   ICON COLORS
   ===================================================== */

.blue .icon-box {
    background: #eef3ff;
    color: #4263eb;
}

.green .icon-box {
    background: #eaf8f1;
    color: #16a36a;
}

.orange .icon-box {
    background: #fff4e6;
    color: #f08c00;
}

.purple .icon-box {
    background: #f3edff;
    color: #7950f2;
}

.pink .icon-box {
    background: #fff0f5;
    color: #e64980;
}

.teal .icon-box {
    background: #e8f8f7;
    color: #109898;
}

.red .icon-box {
    background: #fff0f0;
    color: #e03131;
}

.indigo .icon-box {
    background: #eef0ff;
    color: #4c6ef5;
}


/* =====================================================
   WIDE CARD
   ===================================================== */

.wide {
    grid-column: span 2;

    min-height: 82px;

    flex-direction: row;

    align-items: center;

    justify-content: flex-start;

    gap: 14px;
}

.wide .button-name {
    margin-top: 0;
}


/* =====================================================
   DARK MODE
   ===================================================== */

/*
   We use the presence of the external
   #darkMode style as the dark-mode signal.

   Light mode:
       Card = #FFFFFF

   Dark mode:
       Card = #181A1F
*/


/* Always keep background transparent */

html,
body {
    background: transparent !important;
}


/* -----------------------------------------------------
   DARK MODE CARD
   ----------------------------------------------------- */

html.dark-active .home-button {
    background: #181A1F !important;

    border-color: #292C33 !important;

    box-shadow:
        0 3px 12px rgba(0, 0, 0, 0.22);
}


/* Dark text */

html.dark-active .section-title {
    color: #F1F3F5 !important;
}

html.dark-active .button-name {
    color: #F1F3F5 !important;
}

html.dark-active .button-subtitle {
    color: #9BA1AC !important;
}


/* =====================================================
   RESPONSIVE
   ===================================================== */

@media (min-width: 600px) {

    .button-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .wide {
        grid-column: span 3;
    }

}

</style>
</head>


<body>

<div class="home-section">

    <div class="section-title">
        Quick Access
    </div>


    <div class="button-grid">


        <!-- =================================================
             1. REMEDIES
             ================================================= -->

        <div class="home-button blue"
             onclick="buttonClick('Remedies')">

            <div class="icon-box">

                <span class="material-symbols-rounded">
                    medication
                </span>

            </div>

            <div>

                <div class="button-name">
                    Remedies
                </div>

                <div class="button-subtitle">
                    Browse remedies
                </div>

            </div>

        </div>


        <!-- =================================================
             2. MATERIA MEDICA
             ================================================= -->

        <div class="home-button green"
             onclick="buttonClick('Materia Medica')">

            <div class="icon-box">

                <span class="material-symbols-rounded">
                    menu_book
                </span>

            </div>

            <div>

                <div class="button-name">
                    Materia Medica
                </div>

                <div class="button-subtitle">
                    Explore medicines
                </div>

            </div>

        </div>


        <!-- =================================================
             3. REPERTORY
             ================================================= -->

        <div class="home-button orange"
             onclick="buttonClick('Repertory')">

            <div class="icon-box">

                <span class="material-symbols-rounded">
                    search
                </span>

            </div>

            <div>

                <div class="button-name">
                    Repertory
                </div>

                <div class="button-subtitle">
                    Find rubrics
                </div>

            </div>

        </div>


        <!-- =================================================
             4. APHORISMS
             ================================================= -->

        <div class="home-button purple"
             onclick="buttonClick('Aphorisms')">

            <div class="icon-box">

                <span class="material-symbols-rounded">
                    format_quote
                </span>

            </div>

            <div>

                <div class="button-name">
                    Aphorisms
                </div>

                <div class="button-subtitle">
                    Organon aphorisms
                </div>

            </div>

        </div>


        <!-- =================================================
             5. COURSES
             ================================================= -->

        <div class="home-button pink"
             onclick="buttonClick('Courses')">

            <div class="icon-box">

                <span class="material-symbols-rounded">
                    school
                </span>

            </div>

            <div>

                <div class="button-name">
                    Courses
                </div>

                <div class="button-subtitle">
                    Learn & study
                </div>

            </div>

        </div>


        <!-- =================================================
             6. COLLEGES
             ================================================= -->

        <div class="home-button teal"
             onclick="buttonClick('Colleges')">

            <div class="icon-box">

                <span class="material-symbols-rounded">
                    account_balance
                </span>

            </div>

            <div>

                <div class="button-name">
                    Colleges
                </div>

                <div class="button-subtitle">
                    Find colleges
                </div>

            </div>

        </div>


        <!-- =================================================
             7. PRESCRIBERS
             ================================================= -->

        <div class="home-button red"
             onclick="buttonClick('Prescribers')">

            <div class="icon-box">

                <span class="material-symbols-rounded">
                    stethoscope
                </span>

            </div>

            <div>

                <div class="button-name">
                    Prescribers
                </div>

                <div class="button-subtitle">
                    Clinical resources
                </div>

            </div>

        </div>


        <!-- =================================================
             8. BOOKS
             ================================================= -->

        <div class="home-button indigo"
             onclick="buttonClick('Books')">

            <div class="icon-box">

                <span class="material-symbols-rounded">
                    library_books
                </span>

            </div>

            <div>

                <div class="button-name">
                    Books
                </div>

                <div class="button-subtitle">
                    Browse library
                </div>

            </div>

        </div>


        <!-- =================================================
             9. FAVORITES
             ================================================= -->

        <div class="home-button wide blue"
             onclick="buttonClick('Favorites')">

            <div class="icon-box">

                <span class="material-symbols-rounded">
                    star
                </span>

            </div>

            <div>

                <div class="button-name">
                    Favorites
                </div>

                <div class="button-subtitle">
                    Access your saved resources
                </div>

            </div>

        </div>


    </div>

</div>


<script>

/* =====================================================
   KODULAR BUTTON CLICK
   ===================================================== */

function buttonClick(name) {

    if (window.AppInventor) {
        window.AppInventor.setWebViewString(name);
    }

    console.log("Clicked:", name);
}


/* =====================================================
   DARK MODE DETECTION
   ===================================================== */

/*
   Kodular adds/removes:

   <style id="darkMode">
       ...
   </style>

   We watch for that style.

   If it exists:
       dark-active = ON

   If removed:
       dark-active = OFF
*/


function checkDarkMode() {

    var darkStyle = document.getElementById("darkMode");

    if (darkStyle) {

        document.documentElement.classList.add("dark-active");

    } else {

        document.documentElement.classList.remove("dark-active");

    }
}


/* Check when page loads */

checkDarkMode();


/* Watch for Kodular injecting/removing darkMode */

var observer = new MutationObserver(function() {

    checkDarkMode();

});


observer.observe(document.documentElement, {

    childList: true,

    subtree: true

});

</script>

</body>
</html>