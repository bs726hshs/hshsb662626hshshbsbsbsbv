            </div>

            <div>
                <div class="button-name">
                    Aphorisms
                </div>

                <div class="button-subtitle">
                    Organon aphorisms
                </div>
            </div>

        </div>


        <!-- 5 -->
        <div class="home-button pink"
             onclick="buttonClick('Courses')">

            <div class="icon-box">
                <span class="material-symbols-rounded">
                    school
                </span>
            </div>

            <div>
                <div class="button-name">
                    Courses
                </div>

                <div class="button-subtitle">
                    Learn & study
                </div>
            </div>

        </div>


        <!-- 6 -->
        <div class="home-button teal"
             onclick="buttonClick('Colleges')">

            <div class="icon-box">
                <span class="material-symbols-rounded">
                    account_balance
                </span>
            </div>

            <div>
                <div class="button-name">
                    Colleges
                </div>

                <div class="button-subtitle">
                    Find colleges
                </div>
            </div>

        </div>


        <!-- 7 -->
        <div class="home-button red"
             onclick="buttonClick('Prescribers')">

            <div class="icon-box">
                <span class="material-symbols-rounded">
                    stethoscope
                </span>
            </div>

            <div>
                <div class="button-name">
                    Prescribers
                </div>

                <div class="button-subtitle">
                    Clinical resources
                </div>
            </div>

        </div>


        <!-- 8 -->
        <div class="home-button indigo"
             onclick="buttonClick('Books')">

            <div class="icon-box">
                <span class="material-symbols-rounded">
                    library_books
                </span>
            </div>

            <div>
                <div class="button-name">
                    Books
                </div>

                <div class="button-subtitle">
                    Browse library
                </div>
            </div>

        </div>


        <!-- WIDE BUTTON -->
        <div class="home-button wide blue"
             onclick="buttonClick('Favorites')">

            <div class="icon-box">
                <span class="material-symbols-rounded">
                    star
                </span>
            </div>

            <div>
                <div class="button-name">
                    Favorites
                </div>

                <div class="button-subtitle">
                    Access your saved resources
                </div>
            </div>

        </div>


    </div>

</div>


<script>

function buttonClick(name) {

    /*
       Kodular WebViewer JavaScript interface
    */

    if (window.AppInventor) {
        window.AppInventor.setWebViewString(name);
    }

    console.log("Clicked:", name);
}


/* =========================
   DARK MODE CONTROL
   ========================= */

function setDarkMode(enabled) {

    if (enabled) {
        document.documentElement.classList.add("dark-mode");
    } else {
        document.documentElement.classList.remove("dark-mode");
    }

}

</script>

</body>
</html>