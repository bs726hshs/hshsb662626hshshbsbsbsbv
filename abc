<!DOCTYPE html>
<html>

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>

/* =========================
   MATERIAL SYMBOLS
   ========================= */

@font-face {
    font-family: 'Material Symbols Rounded';
    font-style: normal;
    font-weight: 500;
    src: url(file:///android_asset/gicons.woff2) format('woff2');
}

.material-symbols-rounded {
    font-family: 'Material Symbols Rounded';
    font-weight: normal;
    font-style: normal;
    font-size: 24px;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    display: inline-block;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    -webkit-font-feature-settings: 'liga';
    -webkit-font-smoothing: antialiased;
}


/* =========================
   BASE
   ========================= */

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    background: transparent !important;
}

body {
    padding: 12px;
    font-family: Arial, sans-serif;
    color: #202124;
}


/* =========================
   HOME SECTION
   ========================= */

.home-section {
    width: 100%;
}

.section-title {
    font-size: 18px;
    font-weight: 700;
    margin: 4px 3px 12px;
    color: #202124;
}


/* =========================
   BUTTON GRID
   ========================= */

.button-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}


/* =========================
   HOME BUTTON
   ========================= */

.home-button {
    position: relative;
    min-height: 105px;
    border-radius: 20px;
    background: #ffffff;
    border: 1px solid #edf0f4;
    padding: 16px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    cursor: pointer;
    overflow: hidden;

    box-shadow:
        0 3px 12px rgba(40, 50, 70, 0.06);

    transition:
        transform 0.15s ease,
        box-shadow 0.15s ease;
}

.home-button:active {
    transform: scale(0.97);

    box-shadow:
        0 2px 7px rgba(40, 50, 70, 0.05);
}


/* =========================
   ICON BOX
   ========================= */

.icon-box {
    width: 42px;
    height: 42px;

    border-radius: 14px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #eef3ff;
    color: #4263eb;
}

.icon-box .material-symbols-rounded {
    font-size: 24px;
}


/* =========================
   TEXT
   ========================= */

.button-name {
    font-size: 15px;
    font-weight: 700;
    margin-top: 12px;
    color: #252a34;
}

.button-subtitle {
    font-size: 11px;
    margin-top: 4px;
    color: #858b98;
    font-weight: 500;
}


/* =========================
   ICON COLORS
   ========================= */

.blue .icon-box {
    background: #eef3ff;
    color: #4263eb;
}

.green .icon-box {
    background: #eaf8f1;
    color: #16a36a;
}

.orange .icon-box {
    background: #fff4e6;
    color: #f08c00;
}

.purple .icon-box {
    background: #f3edff;
    color: #7950f2;
}

.pink .icon-box {
    background: #fff0f5;
    color: #e64980;
}

.teal .icon-box {
    background: #e8f8f7;
    color: #109898;
}

.red .icon-box {
    background: #fff0f0;
    color: #e03131;
}

.indigo .icon-box {
    background: #eef0ff;
    color: #4c6ef5;
}


/* =========================
   WIDE BUTTON
   ========================= */

.wide {
    grid-column: span 2;
    min-height: 82px;

    flex-direction: row;
    align-items: center;
    justify-content: flex-start;

    gap: 14px;
}

.wide .button-name {
    margin-top: 0;
}

.wide .button-subtitle {
    margin-top: 4px;
}


/* =========================
   DARK MODE
   =========================
   
   IMPORTANT:
   Do NOT put background on html.
   This keeps Kodular WebViewer transparent.
   
   The invert filter is applied to the
   content instead of html.
   ========================= */

html.dark-mode,
html.dark-mode body {
    background: transparent !important;
}


/* Dark mode content */

html.dark-mode body {
    filter: invert(1) hue-rotate(180deg) !important;
}


/* Restore images/media after body inversion */

html.dark-mode img,
html.dark-mode video,
html.dark-mode iframe,
html.dark-mode canvas,
html.dark-mode svg {
    filter: invert(1) hue-rotate(180deg) !important;
}


/* =========================
   RESPONSIVE
   ========================= */

@media (min-width: 600px) {

    .button-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .wide {
        grid-column: span 3;
    }

}

</style>
</head>


<body>

<div class="home-section">

    <div class="section-title">
        Quick Access
    </div>


    <div class="button-grid">


        <!-- 1 -->
        <div class="home-button blue"
             onclick="buttonClick('Remedies')">

            <div class="icon-box">
                <span class="material-symbols-rounded">
